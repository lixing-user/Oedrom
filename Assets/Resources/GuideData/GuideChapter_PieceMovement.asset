  pages:
  - title: Pawn
    description: "\u6B65\u5175\u968A\uFF0C\u5728\u6230\u722D\u6253\u97FF\u6642\u53EF\u4EE5\u9032\u884C\u4E00\u6B21\u77ED\u8DDD\u96E2\u7684\u885D\u92D2\u3002\u505A\u70BA\u57FA\u672C\u7684\u6230\u529B\u55AE\u4F4D\uFF0C\u5728\u6230\u722D\u4E2D\u8CA0\u8CAC\u727D\u5236\u8207\u6230\u7DDA\u63A8\u9032\u3002\n\n[\u5730\u5F62\u898F\u5247]\n\u53EF\u90E8\u7F72
      \u300B \u5E73\u539F\u3001\u68EE\u6797\u3001\u5C71\u5CB3\u3001\u6CB3\u6D41\n\u53EF\u7A7F\u8D8A
      \u300B \u5E73\u539F\u3001\u68EE\u6797"
    illustration: {fileID: -949996681, guid: c82440679a8f2d94ea419ec661d8a4a9, type: 3}
  - title: Rook
    description: "\u6230\u8ECA\u968A\uFF0C\u53EF\u4EE5\u5F80\u524D\u3001\u5F8C\u3001\u5DE6\u3001\u53F3\u56DB\u65B9\u505A\u9577\u8DDD\u96E2\u885D\u92D2\u3002\u5176\u76F4\u7DDA\u7A81\u9032\u7684\u5A01\u8105\u529B\u9A5A\u4EBA\uFF0C\u662F\u5340\u57DF\u4F5C\u6230\u4E2D\u76F8\u7576\u512A\u79C0\u7684\u6230\u529B\u3002\n\n[\u5730\u5F62\u898F\u5247]\n\u53EF\u90E8\u7F72
      \u300B \u5E73\u539F\u3001\u68EE\u6797\n\u53EF\u7A7F\u8D8A \u300B \u5E73\u539F\u3001\u68EE\u6797"
    illustration: {fileID: 1069630793, guid: c82440679a8f2d94ea419ec661d8a4a9, type: 3}
  - title: Knight
    description: "\u9A0E\u5175\u968A\uFF0C\u4EE5L\u5F62\u7684\u659C\u89D2\u70BA\u79FB\u52D5\u65B9\u5F0F\u3002\u4EE5\u9AD8\u6A5F\u52D5\u6027\u8457\u7A31\uFF0C\u5E7E\u4E4E\u4E0D\u53D7\u5730\u5F62\u9650\u5236\u7684\u540C\u6642\u9084\u53EF\u4EE5\u8D8A\u904E\u6575\u65B9\u524D\u6392\u55AE\u4F4D\u3002\n\n[\u5730\u5F62\u898F\u5247]\n\u53EF\u90E8\u7F72
      \u300B \u5E73\u539F\u3001\u68EE\u6797\u3001\u6CB3\u6D41\n\u53EF\u7A7F\u8D8A
      \u300B \u5E73\u539F\u3001\u68EE\u6797\u3001\u5C71\u5CB3\u3001\u6CB3\u6D41"
    illustration: {fileID: 1066638882, guid: c82440679a8f2d94ea419ec661d8a4a9, type: 3}
  - title: Bishop
    description: "\u796D\u53F8\u7FA4\uFF0C\u53EF\u4EE5\u5F80\u659C\u524D\u65B9\u3001\u659C\u5F8C\u65B9\u76844\u500B\u65B9\u5411\u9577\u8DDD\u96E2\u79FB\u52D5\u3002\u9818\u609F\u795E\u660E\u555F\u793A\u800C\u7372\u5F97\u529B\u91CF\u7684\u90E8\u968A\uFF0C\u5728\u5340\u57DF\u6230\u5F8C\u671F\u6642\u662F\u975E\u5E38\u91CD\u8981\u7684\u653B\u64CA\u624B\u6BB5\u3002\n\n[\u5730\u5F62\u898F\u5247]\n\u53EF\u90E8\u7F72
      \u300B \u5E73\u539F\u3001\u68EE\u6797\u3001\u5C71\u5CB3\u3001\u6CB3\u6D41\n\u53EF\u7A7F\u8D8A
      \u300B \u5E73\u539F\u3001\u68EE\u6797"
    illustration: {fileID: 123650807, guid: c82440679a8f2d94ea419ec661d8a4a9, type: 3}
  - title: Queen
    description: "\u5973\u795E\uFF0C\u53EF\u4EE5\u5F808\u65B9\u4F4D\u505A\u8D85\u9577\u8DDD\u96E2\u4F4D\u79FB\u3002\u505A\u70BA\u5F9E\u795E\u754C\u4E0B\u51E1\u7684\u4E0A\u4F4D\u5B58\u5728\uFF0C\u5728\u6230\u722D\u4E2D\u6709\u7121\u53EF\u6BD4\u64EC\u7684\u5BB0\u5236\u529B\u3002\n\n[\u5730\u5F62\u898F\u5247]\n\u53EF\u90E8\u7F72
      \u300B \u5E73\u539F\u3001\u68EE\u6797\u3001\u5C71\u5CB3\u3001\u6CB3\u6D41\n\u53EF\u7A7F\u8D8A
      \u300B \u5E73\u539F\u3001\u68EE\u6797\u3001\u5C71\u5CB3\u3001\u6CB3\u6D41"
    illustration: {fileID: -1512125606, guid: c82440679a8f2d94ea419ec661d8a4a9, type: 3}
  - title: King
    description: "\u9818\u8896\uFF0C\u5728\u6230\u722D\u4E2D\u50C5\u4EE5\u8EAB\u5468\u76848\u65B9\u4F4D\u7684\u77ED\u8DDD\u96E2\u70BA\u653B\u64CA\u7BC4\u570D\u3002\u5750\u93AE\u672C\u71DF\uFF0C\u5728\u5E38\u7406\u4E2D\u662F\u6230\u5834\u4E0A\u6700\u91CD\u8981\u7684\u5B58\u5728\u3002\n\n[\u5730\u5F62\u898F\u5247]\n\u53EF\u90E8\u7F72
      \u300B \u5E73\u539F\u3001\u68EE\u6797\u3001\u5C71\u5CB3\u3001\u6CB3\u6D41\n\u53EF\u7A7F\u8D8A
