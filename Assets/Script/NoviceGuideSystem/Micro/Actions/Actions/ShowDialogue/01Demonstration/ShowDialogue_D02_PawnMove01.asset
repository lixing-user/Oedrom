  dialogueLines:
  - speaker: {fileID: 11400000, guid: cf8e851864496944e82b33749f2289d7, type: 2}
    emotion: 0
    content: "\u90A3\u9EBC\u5148\u5F9E\u300C\u6B65\u5175\u300D\u958B\u59CB\u5427\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: cf8e851864496944e82b33749f2289d7, type: 2}
    emotion: 0
    content: "\u505A\u70BA\u6230\u5834\u6700\u57FA\u672C\u7684\u5175\u7A2E\uFF0C\u7D93\u5E38\u8CA0\u8CAC\u7A69\u5B9A\u63A8\u9032\u8207\u727D\u5236\u7684\u5DE5\u4F5C\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: cf8e851864496944e82b33749f2289d7, type: 2}
    emotion: 0
    content: "\u79FB\u52D5\u8DEF\u5F91\u4E5F\u76F8\u5C0D\u55AE\u7D14\uFF0C\u4E0D\u904E\u561B\u2026"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 81aea06fad86aa54f8460e7faea9602d, type: 2}
    emotion: 0
    content: "\u6240\u8B02\u300C\u4E00\u9F13\u4F5C\u6C23\u300D\u3002\u5728\u672C\u9663\u524D\u65B9\u6642\u80FD\u5920\u767C\u8D77\u885D\u92D2\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 81aea06fad86aa54f8460e7faea9602d, type: 2}
    emotion: 0
    content: "\uFF08\u55EF\uFF0C\u9019\u6B21\u61C9\u8A72\u53EF\u884C\uFF0C\u885D\u5427\u3002\uFF09"
    anchor: 3
    pauseAfterThisLine: 0
