  m_Script: {fileID: 11500000, guid: 72d54b3cc221e0e42b7c1cb08ff4eed8, type: 3}
  m_Name: ShowDialogue_D06_BishopMove
  m_EditorClassIdentifier: Assembly-CSharp::ShowDialogueAction
  dialogueLines:
  - speaker: {fileID: 11400000, guid: cf8e851864496944e82b33749f2289d7, type: 2}
    emotion: 0
    content: "\u56E0\u70BA\u6230\u8ECA\u7684\u6D3B\u8E8D\uFF0C\u6575\u65B9\u4E3B\u5C07\u88AB\u8FEB\u5411\u6211\u8ECD\u7684\u5305\u570D\u7DB2\u9003\u4EA1\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: cf8e851864496944e82b33749f2289d7, type: 2}
    emotion: 0
    content: "\u4E0D\u904E\uFF0C\u9019\u4E5F\u5A01\u8105\u5230\u5176\u4ED6\u90E8\u968A\u4E86\u5462\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 81aea06fad86aa54f8460e7faea9602d, type: 2}
    emotion: 0
    content: "\u6211\u5011\u7684\u4E3B\u5C07\u9084\u6709\u4ED6\u7684\u4EFB\u52D9\uFF0C\u61C9\u6309\u5175\u4E0D\u52D5\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: cf8e851864496944e82b33749f2289d7, type: 2}
    emotion: 0
    content: "\u90A3\u9019\u6642\u5019\u5C31\u9069\u5408\u8B93\u300C\u796D\u53F8\u300D\u884C\u52D5\u4E86\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: cf8e851864496944e82b33749f2289d7, type: 2}
    emotion: 0
    content: "\u8207\u6230\u8ECA\u90FD\u5177\u5099\u9577\u9014\u79FB\u52D5\u80FD\u529B\uFF0C\u4E0D\u904E\u662F\u300C\u659C\u89D2\u79FB\u52D5\u300D\uFF0C\u653B\u64CA\u65B9\u5F0F\u66F4\u63A5\u8FD1\u8FCE\u64CA\u6642\u7684\u6B65\u5175\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 81aea06fad86aa54f8460e7faea9602d, type: 2}
    emotion: 0
    content: "\uFF08\u5FAE\u5999\uFF0C\u53EA\u80FD\u8B93\u4ED6\u5148\u505A\u70BA\u5176\u4ED6\u90E8\u968A\u7684\u4FDD\u93E2\u4E86\uFF09"
    anchor: 3
    pauseAfterThisLine: 0
