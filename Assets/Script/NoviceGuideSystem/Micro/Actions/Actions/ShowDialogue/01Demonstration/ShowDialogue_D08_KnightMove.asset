  - speaker: {fileID: 11400000, guid: cf8e851864496944e82b33749f2289d7, type: 2}
    emotion: 0
    content: "\u5F9E\u6211\u65B9\u7B2C\u4E00\u6B21\u767C\u8D77\u9032\u653B\u4EE5\u4F86\uFF0C\u9A0E\u5175\u90FD\u4E00\u76F4\u9650\u5236\u5C0D\u65B9\u79FB\u52D5\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: cf8e851864496944e82b33749f2289d7, type: 2}
    emotion: 0
    content: "\u300CL\u5B57\u5F62\u300D\u4E14\u300C\u80FD\u5920\u8DE8\u8D8A\u5C0D\u65B9\u8ECD\u968A\u300D\u7684\u6A5F\u52D5\u6027\uFF0C\u5C0D\u5340\u57DF\u6230\u4F86\u8AAA\u975E\u5E38\u68D8\u624B\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 81aea06fad86aa54f8460e7faea9602d, type: 2}
    emotion: 0
