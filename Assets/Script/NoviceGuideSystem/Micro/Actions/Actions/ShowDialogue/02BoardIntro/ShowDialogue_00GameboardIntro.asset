  m_Script: {fileID: 11500000, guid: 72d54b3cc221e0e42b7c1cb08ff4eed8, type: 3}
  m_Name: ShowDialogue_00GameboardIntro
  m_EditorClassIdentifier: Assembly-CSharp::ShowDialogueAction
  dialogueLines:
  - speaker: {fileID: 11400000, guid: cf8e851864496944e82b33749f2289d7, type: 2}
    emotion: 0
    content: "\u770B\u5230\u6C99\u76E4\u6700\u5F8C\u5074\u88AB\u6A19\u8A18\u7684\u68CB\u5B50\u4E86\u55CE\uFF1F\u90A3\u5C31\u662F\u6575\u8ECD\u4E3B\u5C07\u7684\u4F4D\u7F6E\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: cf8e851864496944e82b33749f2289d7, type: 2}
    emotion: 0
    content: "\u6211\u5011\u7684\u4EFB\u52D9\uFF0C\u662F\u5F9E\u5074\u908A\u767C\u8D77\u9032\u653B\uFF0C\u4E26\u5206\u6563\u6575\u65B9\u7684\u90E8\u5206\u8ECD\u529B\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 9331a4f5fa421eb4db22bc3808f4000a, type: 2}
    emotion: 0
    content: "\u5269\u4E0B\u7684\u4EA4\u7D66\u6751\u9577\u7387\u9818\u7684\u6211\u8ECD\u7CBE\u92B3\u662F\u55CE\uFF1F\u771F\u6C92\u52C1\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 9331a4f5fa421eb4db22bc3808f4000a, type: 2}
    emotion: 0
    content: "\u5982\u679C\u6709\u6A5F\u6703\uFF0C\u771F\u60F3\u5C07\u4ED6\u5011\u4E00\u934B\u7AEF\u4E86\u3002"
    anchor: 3
    pauseAfterThisLine: 0
