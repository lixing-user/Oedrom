  m_Script: {fileID: 11500000, guid: 72d54b3cc221e0e42b7c1cb08ff4eed8, type: 3}
  m_Name: ShowDialogue_06LoseCondition
  m_EditorClassIdentifier: Assembly-CSharp::ShowDialogueAction
  dialogueLines:
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u6575\u4EBA\u5C07\u300C\u6B65\u5175\u300D\u63A8\u9032\u5230\u9663\u5730\u524D\u4E86\u2026\u8981\u662F\u5927\u672C\u71DF\u88AB\u5165\u4FB5\u5C31\u842C\u4E8B\u4F11\u77E3\uFF01"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u300C\u6211\u65B9\u5168\u8ECD\u8986\u6C92\u300D\u3001\u300C\u6211\u5011\u7684\u9A0E\u5175\u968A\u9663\u4EA1\u300D\u3001\u300C\u9663\u5730\u88AB\u4FB5\u7565\u300D\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u53EA\u8981\u4E09\u8005\u767C\u751F\u4EFB\u610F\u4E00\u500B\uFF0C\u6751\u9577\u7684\u8A08\u5283\u5C31\u4E0D\u6703\u6210\u7ACB\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u4E0D\u904E\uFF0C\u9084\u8A18\u5F97\u6B65\u5175\u7684\u7279\u6027\u55CE\uFF1F\u5BB9\u6613\u8207\u6B63\u9762\u7684\u68CB\u5B50\u50F5\u6301\u4E0D\u4E0B\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u6211\u5011\u4E5F\u90E8\u5C6C\u300C\u6B65\u5175\u300D\u4F86\u963B\u64CB\u4ED6\u5011\u7684\u884C\u9032\u8DEF\u7DDA\uFF01"
    anchor: 3
    pauseAfterThisLine: 0
