  dialogueLines:
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u5C0D\u65B9\u4E5F\u53EA\u80FD\u63A8\u9032\u6B65\u5175\u4E86\u5462\u3002\u597D\u6A5F\u6703\uFF01"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u6B65\u5175\u7684\u653B\u64CA\u65B9\u5F0F\uFF0C\u662F\u80FD\u5920\u885D\u5411\u300C\u659C\u524D\u65B9\u300D\u7684\u6575\u4EBA\u9032\u884C\u6BB2\u6EC5\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u525B\u624D\u7121\u8996\u5C0D\u65B9\uFF0C\u662F\u70BA\u4E86\u907F\u514D\u7121\u610F\u7FA9\u7684\u50B7\u4EA1\u5C0D\u5427\uFF1F"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 81aea06fad86aa54f8460e7faea9602d, type: 2}
    emotion: 0
    content: "\u7562\u7ADF\u6211\u6709\u8033\u805E\uFF0C\u5E1D\u570B\u5C0D\u5F85\u53DB\u8ECD\u5F9E\u4E0D\u7559\u60C5\u3002"
    anchor: 3
    pauseAfterThisLine: 0
