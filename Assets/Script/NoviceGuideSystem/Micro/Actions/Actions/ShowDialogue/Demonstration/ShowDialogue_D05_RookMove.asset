  dialogueLines:
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u73FE\u5728\u5C40\u52E2\u5927\u597D\uFF0C\u53EF\u4EE5\u958B\u59CB\u4E3B\u52D5\u9032\u653B\u4E86\u3002"
