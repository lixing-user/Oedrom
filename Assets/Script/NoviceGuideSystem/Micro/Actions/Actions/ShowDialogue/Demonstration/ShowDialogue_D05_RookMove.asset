  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u56E0\u70BA\u76E4\u9762\u4E26\u4E0D\u8907\u96DC\uFF0C\u975E\u5E38\u9069\u5408\u300C\u6230\u8ECA\u300D\u63A8\u9032\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u4ED6\u80FD\u5920\u5C0D\u300C\u524D\u5F8C\u5DE6\u53F3\u300D\u76F4\u7DDA\u4E0A\u7684\u6575\u8ECD\u9020\u6210\u5DE8\u5927\u7684\u5A01\u8105\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 81aea06fad86aa54f8460e7faea9602d, type: 2}
    emotion: 0
    content: "\uFF08\u9019\u88E1\u61C9\u8A72\u53EF\u4EE5\u5927\u81BD\u4E00\u9EDE\uFF0C\u76F4\u885D\u5C0D\u65B9\u4E3B\u5C07\uFF09"
