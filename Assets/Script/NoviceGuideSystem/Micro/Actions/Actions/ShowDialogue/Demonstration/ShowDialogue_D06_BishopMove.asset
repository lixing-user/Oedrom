  m_Script: {fileID: 11500000, guid: 72d54b3cc221e0e42b7c1cb08ff4eed8, type: 3}
  m_Name: ShowDialogue_D06_BishopMove
  m_EditorClassIdentifier: Assembly-CSharp::ShowDialogueAction
  dialogueLines:
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u56E0\u70BA\u6230\u8ECA\u7684\u6D3B\u8E8D\uFF0C\u6575\u5C07\u958B\u59CB\u88AB\u8FEB\u5411\u6211\u8ECD\u7684\u5305\u570D\u7DB2\u9003\u4EA1\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u4E0D\u904E\uFF0C\u9019\u4E5F\u5A01\u8105\u5230\u6211\u65B9\u7684\u5176\u4ED6\u90E8\u968A\u4E86\u5462\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 81aea06fad86aa54f8460e7faea9602d, type: 2}
    emotion: 0
    content: "\u6211\u5011\u7684\u4E3B\u5C07\u9084\u6709\u4ED6\u7684\u4EFB\u52D9\uFF0C\u61C9\u6309\u5175\u4E0D\u52D5\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u90A3\u9019\u6642\u5019\u5C31\u9069\u5408\u8B93\u300C\u796D\u53F8\u300D\u884C\u52D5\u4E86\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u8207\u6B65\u5175\u7684\u653B\u64CA\u65B9\u5F0F\u4E00\u6A23\uFF0C\u537B\u4E0D\u6703\u53D7\u9650\u65BC\u8DDD\u96E2\uFF0C\u66F4\u80FD\u5920\u61C9\u5C0D\u5F8C\u65B9\u7684\u5A01\u8105\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 81aea06fad86aa54f8460e7faea9602d, type: 2}
    emotion: 0
    content: "\uFF08\u73FE\u5728\u4E5F\u53EA\u80FD\u8B93\u4ED6\u7576\u9A0E\u5175\u7684\u4FDD\u93E2\u4E86\uFF09"
    anchor: 3
    pauseAfterThisLine: 0
