  - speaker: {fileID: 11400000, guid: cf8e851864496944e82b33749f2289d7, type: 2}
    emotion: 0
    content: "\u90A3\u9EBC\u4E8B\u4E0D\u5B9C\u9072\uFF0C\u5F9E\u300C\u5F85\u547D\u5340\u300D\u5C07\u6B65\u5175\u90E8\u7F72\u5728\u6C99\u76E4\u4E0A\u5427\uFF01"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: cf8e851864496944e82b33749f2289d7, type: 2}
    emotion: 0
    content: "\u5F85\u547D\u5340\u7684\u68CB\u5B50\u53EA\u80FD\u5F9E\u300C\u89D2\u843D\u56DB\u683C\u300D\u8FD4\u56DE\u6230\u5834\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: cf8e851864496944e82b33749f2289d7, type: 2}
    emotion: 0
    content: "\u50CF\u5E73\u5E38\u4E00\u6A23\uFF0C\u76F4\u63A5\u300C\u9078\u53D6\u7136\u5F8C\u79FB\u52D5\u300D\u5C31\u53EF\u4EE5\u4E86"
