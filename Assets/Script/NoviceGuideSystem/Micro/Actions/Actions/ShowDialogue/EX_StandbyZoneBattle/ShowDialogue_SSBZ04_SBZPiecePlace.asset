  dialogueLines:
  - speaker: {fileID: 11400000, guid: 81aea06fad86aa54f8460e7faea9602d, type: 2}
    emotion: 0
    content: "\uFF08\u300C\u5F85\u547D\u5340\u300D\u591A\u4E86\u5169\u679A\u68CB\u5B50\uFF01\uFF09"
