  - speaker: {fileID: 11400000, guid: 9331a4f5fa421eb4db22bc3808f4000a, type: 2}
    emotion: 0
    content: "\u5C31\u662F\u591A\u4E86\u500B\u5927\u584A\u982D\u7AD9\u54E8\u3002\u9019\u4E5F\u8DDF\u5E73\u5E38\u6C92\u5DEE\u591A\u5C11\u561B\uFF01"
