  dialogueLines:
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u54FC\u54FC\uFF0C\u6211\u7E3D\u7B97\u60F3\u660E\u767D\u4E86\uFF01"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u5E1D\u570B\u7684\u8ECD\u968A\u7684\u5927\u591A\u6578\u5B8C\u5168\u5C31\u662F\u88AB\u5F37\u8FEB\u5145\u8ECD\u7684\u8001\u767E\u59D3\u800C\u5DF2\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u4E5F\u5C31\u662F\u8AAA\uFF0C\u6575\u65B9\u7684\u4E3B\u5E25\u6839\u672C\u4E0D\u5F97\u6C11\u5FC3\u554A\uFF01"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u4E5F\u96E3\u602A\u4E4B\u524D\u7684\u6230\u9B25\u4E2D\u7E3D\u6703\u51FA\u73FE\u4E00\u5806\u8A6D\u7570\u7684\u884C\u70BA\u4E86\u3002"
    anchor: 3
    pauseAfterThisLine: 0
