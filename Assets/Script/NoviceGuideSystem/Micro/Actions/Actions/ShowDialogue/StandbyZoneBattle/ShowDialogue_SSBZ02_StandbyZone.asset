  dialogueLines:
  - speaker: {fileID: 11400000, guid: 9331a4f5fa421eb4db22bc3808f4000a, type: 2}
    emotion: 0
    content: "\u9019\u5565\uFF1F\u5728\u4E4B\u524D\u7684\u6C99\u76E4\u63A8\u6F14\u4E2D\u6709\u9019\u500B\u7269\u4EF6\u55CE\uFF1F"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u9019\u662F\u300C\u5F85\u547D\u5340\u300D\uFF0C\u5C08\u9580\u70BA\u7ACB\u5834\u6416\u64FA\u7684\u6575\u8ECD\u6240\u6E96\u5099\u7684\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 9331a4f5fa421eb4db22bc3808f4000a, type: 2}
    emotion: 0
    content: "\u5509\uFF0C\u59B3\u9084\u6C92\u653E\u68C4\u9019\u7A2E\u7121\u610F\u7FA9\u7684\u884C\u70BA\u5594\uFF0C\u5927\u59D0\u982D\uFF1F"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u7B49\u6230\u9B25\u958B\u59CB\u4F60\u5C31\u77E5\u9053\u4E86\u3002"
    anchor: 3
    pauseAfterThisLine: 0
