  m_Script: {fileID: 11500000, guid: 72d54b3cc221e0e42b7c1cb08ff4eed8, type: 3}
  m_Name: ShowDialogue_14MidGoal
  m_EditorClassIdentifier: Assembly-CSharp::ShowDialogueAction
  dialogueLines:
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u6240\u4EE5\uFF0C\u5728\u7E7C\u7E8C\u57F7\u884C\u5077\u8972\u8A08\u5283\u524D\uFF0C\u524D\u5F80\u897F\u5074\u7684\u6751\u838A\u662F\u7D55\u5C0D\u5FC5\u8981\u7684\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 9331a4f5fa421eb4db22bc3808f4000a, type: 2}
    emotion: 0
    content: "\u8AAA\u662F\u9019\u9EBC\u8AAA\uFF0C\u4F46\u524D\u9032\u7684\u8DEF\u4E0A\u4E5F\u4E0D\u6703\u7E3D\u662F\u7CDF\u5FC3\u4E8B\u5427\uFF01"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 9331a4f5fa421eb4db22bc3808f4000a, type: 2}
    emotion: 0
    content: "\u53EF\u80FD\u6CBF\u8DEF\u7684\u8FB2\u6C11\u593E\u9053\u6B61\u8FCE\u3001\u737B\u4E0A\u7269\u8CC7\u4E4B\u985E\u7684\uFF1F"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: 81aea06fad86aa54f8460e7faea9602d, type: 2}
    emotion: 0
    content: "\u4E0D\u7121\u53EF\u80FD\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u2026\u4F46\u7E3D\u4E0D\u80FD\u90FD\u4EA4\u7D66\u904B\u6C23\u6C7A\u5B9A\u7684\u5427\u3002"
    anchor: 3
    pauseAfterThisLine: 0
  - speaker: {fileID: 11400000, guid: a4480f420e45c634daa0dec9fe5b7bb1, type: 2}
    emotion: 0
    content: "\u7E3D\u4E4B\uFF0C\u70BA\u4E86\u907F\u514D\u7269\u8CC7\u8017\u76E1\uFF0C\u9084\u662F\u7E5E\u500B\u8DEF\u5427\u3002"
    anchor: 3
    pauseAfterThisLine: 0
